# Copy to config.env and adjust. Sourced by build.sh and upload.sh.

# Where finished bundles are uploaded (build.sh --upload / upload.sh):
#   user@host:/srv/immich-bundle/      rsync/scp
#   https://files.example.org/immich/   HTTP PUT (curl -T)
#   /mnt/share/immich-bundle           local/mounted directory
#UPLOAD_TARGET=
#UPLOAD_CURL_OPTS="--user uploader:secret"

# Build instance (must not collide with your running instances)
#BUILD_NAME=immich-bundle-build
#BUILD_PORT=127.0.0.1:12283

#SAMPLE=/path/to/a/real/photo-with-a-face.jpg
#TIMEOUT=3600
# OCR model to bundle; empty = immich default (PP-OCRv5_mobile)
#OCR_MODEL=ESLAV__PP-OCRv5_mobile
#VERSION=latest
