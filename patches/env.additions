
# --- immich-bundle additions (patches/env.additions) --------------------------
# Compose project name of this instance; containers become
# <INSTANCE_NAME>-immich-server-1, ... (lowercase letters, digits, - and _)
INSTANCE_NAME=immich
# Host folder for the machine learning models (filled from models.tar.gz)
MODEL_LOCATION=./model-cache
# Published port, may include a bind address, e.g. 127.0.0.1:2284
IMMICH_PORT=2283
